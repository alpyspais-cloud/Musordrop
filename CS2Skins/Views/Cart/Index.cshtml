@model List<CS2Skins.Models.Skin>

@{
    ViewData["Title"] = "Корзина";
}

<div class="cart-page">
    <h1>Корзина</h1>

    @if (Model.Count == 0)
    {
        <div class="empty-cart">
            <h2>Корзина пуста</h2>
            <p>Добавь несколько скинов из магазина.</p>

            <a asp-controller="Shop"
               asp-action="Index"
               class="shop-button">
                Перейти в магазин
            </a>
        </div>
    }
    else
    {
        <div class="cart-items">
            @foreach (var skin in Model)
            {
                <div class="cart-item">
                    <img src="@skin.ImageUrl" alt="@skin.Name" />

                    <div class="cart-item-info">
                        <small>@skin.Weapon</small>
                        <h3>@skin.Name</h3>
                        <strong>$@skin.Price</strong>
                    </div>

                    <a asp-controller="Cart"
                       asp-action="Remove"
                       asp-route-id="@skin.Id"
                       class="remove-button">
                        Удалить
                    </a>
                </div>
            }
        </div>
    }
</div>
